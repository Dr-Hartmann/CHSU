<mah:MetroWindow x:Class="MikuDbLab4.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:MikuDbLab4"
                 mc:Ignorable="d"
                 Title="МикуцкихПрБД_Lab4"
                 MinHeight="500" MinWidth="800"
                 Height="500" Width="800"
                 WindowStartupLocation="CenterScreen">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Rows="1" HorizontalAlignment="Left" Margin="0,0,0,5">
            <TextBox x:Name="HostTextBox" Text="localhost" mah:TextBoxHelper.Watermark="Хост-адрес" HorizontalContentAlignment="Center"/>
            <TextBox x:Name="PortTextBox" Text="9900" mah:TextBoxHelper.Watermark="Порт" HorizontalContentAlignment="Center"/>
            <TextBox x:Name="ServiceTextBox" Text="XE" mah:TextBoxHelper.Watermark="Сервис" HorizontalContentAlignment="Center"/>
            <TextBox x:Name="SchemaTextBox" Text="STUDENT" mah:TextBoxHelper.Watermark="Имя схемы" HorizontalContentAlignment="Center"/>
            <TextBox x:Name="PasswordTextBox" Text="root" mah:TextBoxHelper.Watermark="Пароль" HorizontalContentAlignment="Center"/>
            <TextBox x:Name="TableTextBox" Text="MIKULAB4" mah:TextBoxHelper.Watermark="Таблица" HorizontalContentAlignment="Center"/>
        </UniformGrid>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,5">
            <UniformGrid HorizontalAlignment="Right">
                <Button Content="Обновить данные" Click="UpdateTable_Click"/>
            </UniformGrid>
        </UniformGrid>

        <DataGrid
            Grid.Row="3"
            x:Name="TableDataGrid" d:ItemsSource="{d:SampleData ItemCount=5}"
            AlternatingRowBackground="AntiqueWhite"
            AutoGenerateColumns="True"
            AutoGeneratingColumn="TableDataGrid_AutoGeneratingColumn"
            CanUserReorderColumns="False"
            CanUserResizeColumns="False"
            CanUserAddRows="True"
            IsReadOnly="False"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"/>

    </Grid>
</mah:MetroWindow>
