<Window x:Class="CNandTMikuLab6.Reference"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CNandTMikuLab6.Views"
        Title="Справка" 
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen">
        <!--MaxHeight="500" MaxWidth="800"-->
    <Grid Margin="10">
        <!--SizeToContent="Width"-->
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="SegmentsTable"
                  BorderBrush="#FF0081FF"
                  CanUserResizeColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <!--ScrollViewer.HorizontalScrollBarVisibility="Disabled"-->
        <Label Grid.Row="1" VerticalContentAlignment="Center">
            <TextBlock x:Name="About" TextWrapping="Wrap"/>
        </Label>
    </Grid>
</Window>
