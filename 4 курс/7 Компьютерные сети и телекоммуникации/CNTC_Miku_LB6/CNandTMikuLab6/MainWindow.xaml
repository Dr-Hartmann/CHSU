<Window x:Class="CNandTMikuLab6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CNandTMikuLab6.Views"
        xmlns:vm="clr-namespace:CNandTMikuLab6.ViewModels"
        xmlns:ext="clr-namespace:CNandTMikuLab6.Attributes"
        d:DataContext="{d:DesignInstance Type=views:Item}"
        mc:Ignorable="d"
        Title="LAB6_МикуцкихГА" 
        MinHeight="300" MinWidth="600" 
        Icon="/ico.png" 
        WindowStyle="ThreeDBorderWindow"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Сервисы">
                <MenuItem Header="Справка" Click="OpenReference"/>
                <MenuItem Header="Источники" Click="NavigateSource"/>
                <Separator/>
                <MenuItem Header="Не нажимать" Click="Exit"/>
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="9*"/>
                <RowDefinition Height="1*" MinHeight="30"/>
            </Grid.RowDefinitions>
            <DataGrid 
                Grid.Row="0" x:Name="SegmentsTable" 
                CanUserResizeColumns="False"
                BeginningEdit="Grid_BeginningEdit"
                AutoGenerateColumns="False"
                ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=Window}}"
                d:ItemsSource="{d:SampleData ItemCount=5}">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn
                        Header="{ext:ColumnHeader {x:Type views:Item}, Obj}"
                        ItemsSource="{x:Static views:Item.ListData}"
                        SelectedItemBinding="{Binding Obj, Mode=TwoWay}"/>
                    <DataGridTextColumn 
                        Header="{ext:ColumnHeader {x:Type views:Item}, Length}"
                        Binding="{Binding Length, Mode=TwoWay}"/>
                </DataGrid.Columns>
            </DataGrid>
            <UniformGrid Grid.Row="1" Rows="1" Columns="2">
                <Button Content="Расчитать" HorizontalAlignment="Left" Width="100" Click="Button_Click"/>
                <Button Content="Очистить" HorizontalAlignment="Right" Width="100" Click="ClearSegmentsTable"/>
            </UniformGrid>
        </Grid>
    </DockPanel>
</Window>
