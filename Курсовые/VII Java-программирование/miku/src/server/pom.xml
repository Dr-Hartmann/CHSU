<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.miku</groupId>
        <artifactId>miku</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>server</artifactId>
    <description>Серверная часть на Spring Boot
    </description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- =============================================================== -->
        <!-- 1. ВНУТРЕННИЕ МОДУЛИ ПРОЕКТА                                    -->
        <!-- =============================================================== -->

        <!-- Содержит общие DTO, утилиты и константы, разделяемые между модулями -->
        <dependency>
            <groupId>com.miku</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- =============================================================== -->
        <!-- 2. CORE SPRING BOOT STARTERS (Основа приложения)                -->
        <!-- =============================================================== -->

        <!-- Создание REST API, включает Tomcat и Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Валидация входных данных (Bean Validation / Hibernate Validator) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- =============================================================== -->
        <!-- 3. РАБОТА С ДАННЫМИ И ПЕРСИСТЕНТНОСТЬ                           -->
        <!-- =============================================================== -->

        <!-- Взаимодействие с БД через Hibernate и Spring Data Repositories -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- =============================================================== -->
        <!-- 4. ГЕНЕРАЦИЯ КОДА И МАППИНГ (Инструменты разработчика)          -->
        <!-- =============================================================== -->

        <!-- Автогенерация кода (геттеры, сеттеры, логгеры) для уменьшения шаблонного кода -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Безопасное преобразование (маппинг) между Entity и DTO -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- =============================================================== -->
        <!-- 5. ДОКУМЕНТАЦИЯ API                                             -->
        <!-- =============================================================== -->

        <!-- Автоматическая генерация документации Swagger/OpenAPI 3 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- =============================================================== -->
        <!-- 6. ТЕСТИРОВАНИЕ                                                 -->
        <!-- =============================================================== -->

        <!-- Набор библиотек для тестов: JUnit 5, Mockito, AssertJ, Spring Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>


        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <!-- Профили БД для разных сред окружения -->
    <profiles>
        <!-- Профиль для локальной разработки -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>

        <!-- Профиль для продакшн-сервера -->
        <profile>
            <id>prod</id>
            <dependencies>
                <dependency>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <annotationProcessorPaths>
                        <!-- Настройка совместной работы Lombok и MapStruct при компиляции -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>