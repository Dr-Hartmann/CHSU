VERSION=1.0.0

# Клиент
APP_CLIENT_PORT=5050
CLIENT_PROFILE=prod

# Сервер
APP_SERVER_PORT=8080
SERVER_PROFILE=prod

# БД
DB_NAME=mikuDb
DB_USER=miku
DB_PASSWORD=12345
DB_DRIVER=org.postgresql.Driver
DB_PORT=5432
DB_URL=jdbc:postgresql://postgres:${DB_PORT}/${DB_NAME}

# pgAdmin
ADMIN_PORT=80
DEFAULT_EMAIL=dr.hartmann86@gmail.com
DEFAULT_PASSWORD=12345
MASTER_PASSWORD_REQUIRED=False

JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom
LOG_LEVEL=INFO